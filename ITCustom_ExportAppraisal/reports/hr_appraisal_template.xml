<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report template for PDF generation -->
    <template id="report_hr_appraisal_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="row">
                            <div class="col-12 text-center">
                                <h5 style="font-size: 14px;">PENILAIAN KINERJA PT. OMEGA MAS</h5>
                            </div>
                        </div>
                        
                        <div class="row mt-4">
                            <div class="col-6">
                                <p style="font-size: 11px;"><strong>Nama:</strong> <span t-field="o.employee_id.name"/></p>
                            </div>
                            <div class="col-6">
                                <p style="font-size: 11px;"><strong>Departemen:</strong> <span t-field="o.employee_id.department_id.name"/></p>
                            </div>
                        </div>
                        
                        <div class="row mt-3">
                            <div class="col-6">
                                <p style="font-size: 11px;"><strong>Tanggal Appraisal:</strong> <span t-field="o.date_close"/></p>
                            </div>
                            <div class="col-6">
                                <p style="font-size: 11px;"><strong>Tanggal Appraisal Selanjutnya:</strong> <span t-field="o.next_appraisal_date"/></p>
                            </div>
                        </div>
                        
                        <div class="row mt-3">
                            <div class="col-12">
                                <p style="font-size: 11px;"><strong>Nilai:</strong> <span t-field="o.assessment_note"/></p>
                            </div>
                        </div>
                        
                        <!-- New Skills Table -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <h5 class="mb-3" style="font-size: 12px;">DATA KEAHLIAN (SKILLS)</h5>
                                <table class="table table-bordered" style="font-size: 9px;">
                                    <thead>
                                        <tr>
                                            <th class="text-center" style="width: 5%; font-size: 9px;">No</th>
                                            <th class="text-center" style="width: 20%; font-size: 9px;">Tipe Keahlian</th>
                                            <th class="text-center" style="width: 25%; font-size: 9px;">Keahlian</th>
                                            <th class="text-center" style="width: 15%; font-size: 9px;">Value</th>
                                            <th class="text-center" style="width: 15%; font-size: 9px;">Rata-rata</th>
                                            <th class="text-center" style="width: 10%; font-size: 9px;">Dummy 1</th>
                                            <th class="text-center" style="width: 10%; font-size: 9px;">Dummy 2</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-if="o.skill_ids">
                                            <t t-set="grouped_skills" t-value="{}"/>
                                            <t t-set="skill_totals" t-value="{}"/>
                                            <t t-set="skill_counts" t-value="{}"/>
                                            
                                            <!-- Group skills by skill type and calculate totals -->
                                            <t t-foreach="o.skill_ids" t-as="skill">
                                                <t t-set="skill_type" t-value="skill.skill_type_id.name"/>
                                                <t t-set="skill_value" t-value="int(skill.skill_level_id.level_progress / 20) if skill.skill_level_id.level_progress else 0"/>
                                                
                                                <t t-if="skill_type in grouped_skills">
                                                    <t t-set="grouped_skills" t-value="dict(grouped_skills, **{skill_type: grouped_skills[skill_type] + [skill]})"/>
                                                    <t t-set="skill_totals" t-value="dict(skill_totals, **{skill_type: skill_totals[skill_type] + skill_value})"/>
                                                    <t t-set="skill_counts" t-value="dict(skill_counts, **{skill_type: skill_counts[skill_type] + 1})"/>
                                                </t>
                                                <t t-else="">
                                                    <t t-set="grouped_skills" t-value="dict(grouped_skills, **{skill_type: [skill]})"/>
                                                    <t t-set="skill_totals" t-value="dict(skill_totals, **{skill_type: skill_value})"/>
                                                    <t t-set="skill_counts" t-value="dict(skill_counts, **{skill_type: 1})"/>
                                                </t>
                                            </t>
                                            
                                            <!-- Render grouped skills with averages -->
                                            <t t-set="global_row_index" t-value="0"/>
                                            <t t-foreach="grouped_skills.items()" t-as="group">
                                                <t t-set="skill_type_name" t-value="group[0]"/>
                                                <t t-set="skills_list" t-value="group[1]"/>
                                                <t t-set="skill_count" t-value="len(skills_list)"/>
                                                <t t-set="total_value" t-value="skill_totals[skill_type_name]"/>
                                                <t t-set="average_value" t-value="round(total_value / skill_count, 2)"/>
                                                
                                                <t t-foreach="skills_list" t-as="skill">
                                                    <tr>
                                                        <t t-if="skill_index == 0">
                                                            <td class="text-center" t-att-rowspan="skill_count" style="font-size: 9px;"><t t-esc="global_row_index + 1"/></td>
                                                            <td t-att-rowspan="skill_count" style="font-size: 9px;"><span t-esc="skill_type_name"/></td>
                                                        </t>
                                                        <td style="font-size: 9px;"><span t-field="skill.skill_id.name"/></td>
                                                        <td class="text-center" style="font-size: 9px;">
                                                            <t t-esc="int(skill.skill_level_id.level_progress / 20) if skill.skill_level_id.level_progress else 0"/>
                                                        </td>
                                                        <t t-if="skill_index == 0">
                                                            <td class="text-center" t-att-rowspan="skill_count" style="font-size: 9px;"><t t-esc="average_value"/></td>
                                                            <td class="text-center" t-att-rowspan="skill_count" style="font-size: 9px;">-</td>
                                                            <td class="text-center" t-att-rowspan="skill_count" style="font-size: 9px;">-</td>
                                                        </t>
                                                    </tr>
                                                    <t t-if="skill_index == 0">
                                                        <t t-set="global_row_index" t-value="global_row_index + skill_count"/>
                                                    </t>
                                                </t>
                                            </t>
                                        </t>
                                        <t t-else="">
                                            <tr>
                                                <td colspan="7" class="text-center" style="font-size: 9px;">Tidak ada data keahlian</td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        
                        <div class="row mt-3">
                            <div class="col-12">
                                <hr/>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>

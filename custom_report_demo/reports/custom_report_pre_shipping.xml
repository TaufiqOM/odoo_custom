<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_custom_demo_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <!-- Header with Date/Time and Logo -->
                            <div class="row mb-3">
                                <div class="col-6">
                                    <h3>Custom Demo Report</h3>
                                </div>
                                <div class="col-6 text-end">
                                    <small class="text-muted">
                                        <t t-esc="datetime.datetime.now().strftime('%d/%m/%y, %H:%M')"/>
                                    </small>
                                </div>
                            </div>
                            
                            <div class="row mt-4">
                                <div class="col-6">
                                    <strong>Customer:</strong>
                                    <span t-field="o.partner_id.name"/>
                                    <br/>
                                    <strong>Email:</strong>
                                    <span t-field="o.partner_id.email"/>
                                    <br/>
                                    <strong>Phone:</strong>
                                    <span t-field="o.partner_id.phone"/>
                                </div>
                                <div class="col-6">
                                    <strong>Report Number:</strong>
                                    <span t-field="o.name"/>
                                    <br/>
                                    <strong>Date:</strong>
                                    <span t-field="o.date"/>
                                    <br/>
                                    <strong>Status:</strong>
                                    <span t-field="o.state"/>
                                </div>
                            </div>
                            
                            <div class="row mt-4">
                                <div class="col-12">
                                    <strong>Description:</strong>
                                    <p t-field="o.description"/>
                                </div>
                            </div>
                            
                            <table class="table table-bordered mt-4">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Description</th>
                                        <th class="text-center">Quantity</th>
                                        <th class="text-end">Unit Price</th>
                                        <th class="text-end">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.line_ids" t-as="line">
                                        <tr>
                                            <td>
                                                <span t-field="line.product_id.default_code"/>
                                            </td>
                                            <td>
                                                <span t-field="line.product_id.name"/>
                                            </td>
                                            <td class="text-center">
                                                <span t-field="line.quantity"/>
                                            </td>
                                            <td class="text-end">
                                                <span t-field="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                            </td>
                                            <td class="text-end">
                                                <span t-field="line.subtotal" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                            </td>
                                        </tr>
                                    </t>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="4" class="text-end"><strong>Total Amount:</strong></td>
                                        <td class="text-end">
                                            <strong><span t-field="o.total_amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></strong>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                            
                            <div class="row mt-4">
                                <div class="col-12">
                                    <p class="text-muted">
                                        <small>This is a demo report generated by Custom Report Demo module.</small>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>

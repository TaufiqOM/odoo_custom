<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Simple inheritance to add custom tab -->
    <record id="view_hr_appraisal_form_inherit_custom" model="ir.ui.view">
        <field name="name">hr.appraisal.form.inherit.custom</field>
        <field name="model">hr.appraisal</field>
        <field name="inherit_id" ref="hr_appraisal.view_hr_appraisal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Informasi Tambahan" name="custom_tab">
                    <group>
                        <group string="Penilaian Custom">
                            <field name="custom_rating"/>
                            <field name="custom_date"/>
                            <field name="custom_boolean"/>
                        </group>
                        <group string="Detail Tambahan">
                            <field name="custom_user_id"/>
                            <field name="custom_summary" readonly="1"/>
                        </group>
                    </group>
                    <group string="Catatan">
                        <field name="custom_notes" nolabel="1" placeholder="Masukkan catatan tambahan di sini..."/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

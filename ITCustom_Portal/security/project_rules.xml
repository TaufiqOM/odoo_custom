<odoo>
    <!-- Rule untuk membatasi project dengan privacy_visibility = portal -->
    <record id="project_portal_rule" model="ir.rule">
        <field name="name">Project portal visibility</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="groups" eval="[]"/> <!-- kosong artinya berlaku global -->
        <field name="domain_force">
            [
                '|',
                ('privacy_visibility', '!=', 'portal'),
                '|',
                ('message_follower_ids.partner_id', 'in', [user.partner_id.id]),
                ('collaborator_ids.partner_id', 'in', [user.partner_id.id])
            ]
        </field>
    </record>
</odoo>

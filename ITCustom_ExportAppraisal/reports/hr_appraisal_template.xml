<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report template for PDF generation -->
    <template id="report_hr_appraisal_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="row">
                            <div class="col-12 text-center">
                                <h5 style="font-size: 14px;">PENILAIAN KINERJA PT. OMEGA MAS</h5>
                            </div>
                        </div>
                        
                        <div class="row mt-4">
                            <div class="col-6">
                                <p style="font-size: 11px;"><strong>Nama:</strong> <span t-field="o.employee_id.name"/></p>
                            </div>
                            <div class="col-6">
                                <p style="font-size: 11px;"><strong>Departemen:</strong> <span t-field="o.employee_id.department_id.name"/></p>
                            </div>
                        </div>
                        
                        <div class="row mt-3">
                            <div class="col-6">
                                <p style="font-size: 11px;"><strong>Tanggal Appraisal:</strong> <span t-field="o.date_close"/></p>
                            </div>
                            <div class="col-6">
                                <p style="font-size: 11px;"><strong>Tanggal Appraisal Selanjutnya:</strong> <span t-field="o.next_appraisal_date"/></p>
                            </div>
                        </div>
                        
                        <div class="row mt-3">
                            <div class="col-12">
                                <p style="font-size: 11px;"><strong>Nilai:</strong> <span t-field="o.assessment_note"/></p>
                            </div>
                        </div>
                        
                        <!-- New Skills Table -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <h5 class="mb-3" style="font-size: 12px;">DATA KEAHLIAN (SKILLS)</h5>
                                <table class="table table-bordered" style="font-size: 9px;">
                                    <thead>
                                        <tr>
                                            <th class="text-center" style="width: 5%; font-size: 9px;">No</th>
                                            <th class="text-center" style="width: 8%; font-size: 9px;">Bobot (%)</th>
                                            <th class="text-center" style="width: 18%; font-size: 9px;">Tipe Keahlian</th>
                                            <th class="text-center" style="width: 22%; font-size: 9px;">Keahlian</th>
                                            <th class="text-center" style="width: 15%; font-size: 9px;">Value</th>
                                            <th class="text-center" style="width: 15%; font-size: 9px;">Rata-rata</th>
                                            <th class="text-center" style="width: 10%; font-size: 9px;">TOTAL</th>
                                            <th class="text-center" style="width: 10%; font-size: 9px;">TOTAL 2</th>
                                            <th class="text-center" style="width: 10%; font-size: 9px;">TOTAL 3</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-if="o.skill_ids">
                                            <t t-set="grouped_skills" t-value="{}"/>
                                            <t t-set="skill_totals" t-value="{}"/>
                                            <t t-set="skill_counts" t-value="{}"/>
                                            <t t-set="bobot_totals" t-value="{}"/>
                                            <t t-set="bobot_groups" t-value="{}"/>
                                            
                                            <!-- Group skills by skill type and bobot -->
                                            <t t-foreach="o.skill_ids" t-as="skill">
                                                <t t-set="skill_type" t-value="skill.skill_type_id.name"/>
                                                <t t-set="bobot_key" t-value="skill.bobot_penilaian_percentage"/>
                                                <t t-set="skill_value" t-value="int(skill.skill_level_id.level_progress / 20) if skill.skill_level_id.level_progress else 0"/>
                                                
                                                <!-- Group by skill type for display -->
                                                <t t-if="skill_type in grouped_skills">
                                                    <t t-set="grouped_skills" t-value="dict(grouped_skills, **{skill_type: grouped_skills[skill_type] + [skill]})"/>
                                                    <t t-set="skill_totals" t-value="dict(skill_totals, **{skill_type: skill_totals[skill_type] + skill_value})"/>
                                                    <t t-set="skill_counts" t-value="dict(skill_counts, **{skill_type: skill_counts[skill_type] + 1})"/>
                                                </t>
                                                <t t-else="">
                                                    <t t-set="grouped_skills" t-value="dict(grouped_skills, **{skill_type: [skill]})"/>
                                                    <t t-set="skill_totals" t-value="dict(skill_totals, **{skill_type: skill_value})"/>
                                                    <t t-set="skill_counts" t-value="dict(skill_counts, **{skill_type: 1})"/>
                                                </t>
                                                
                                                <!-- Group by bobot for TOTAL calculation -->
                                                <t t-if="bobot_key in bobot_groups">
                                                    <t t-set="bobot_groups" t-value="dict(bobot_groups, **{bobot_key: bobot_groups[bobot_key] + [skill]})"/>
                                                </t>
                                                <t t-else="">
                                                    <t t-set="bobot_groups" t-value="dict(bobot_groups, **{bobot_key: [skill]})"/>
                                                </t>
                                            </t>
                                            
                                            <!-- Calculate bobot-wise averages and totals -->
                                            <t t-foreach="bobot_groups.items()" t-as="bobot_group">
                                                <t t-set="bobot_key" t-value="bobot_group[0]"/>
                                                <t t-set="skills_in_bobot" t-value="bobot_group[1]"/>
                                                <t t-set="total_value" t-value="0"/>
                                                <t t-set="total_count" t-value="0"/>
                                                
                                                <t t-foreach="skills_in_bobot" t-as="skill_in_bobot">
                                                    <t t-set="skill_value" t-value="int(skill_in_bobot.skill_level_id.level_progress / 20) if skill_in_bobot.skill_level_id.level_progress else 0"/>
                                                    <t t-set="total_value" t-value="total_value + skill_value"/>
                                                    <t t-set="total_count" t-value="total_count + 1"/>
                                                </t>
                                                
                                                <t t-set="average_value" t-value="round(total_value / total_count, 2)"/>
                                                <t t-set="bobot_totals" t-value="dict(bobot_totals, **{bobot_key: average_value})"/>
                                            </t>
                                            
                                            <!-- Calculate row counts for bobot groups -->
                                            <t t-set="bobot_row_counts" t-value="{}"/>
                                            <t t-foreach="grouped_skills.items()" t-as="group">
                                                <t t-set="skill_type_name" t-value="group[0]"/>
                                                <t t-set="skills_list" t-value="group[1]"/>
                                                <t t-set="bobot_key" t-value="skills_list[0].bobot_penilaian_percentage"/>
                                                
                                                <t t-if="bobot_key in bobot_row_counts">
                                                    <t t-set="bobot_row_counts" t-value="dict(bobot_row_counts, **{bobot_key: bobot_row_counts[bobot_key] + len(skills_list)})"/>
                                                </t>
                                                <t t-else="">
                                                    <t t-set="bobot_row_counts" t-value="dict(bobot_row_counts, **{bobot_key: len(skills_list)})"/>
                                                </t>
                                            </t>
                                            
                                            <!-- Render grouped skills with bobot-based TOTAL merging -->
                                            <t t-set="global_row_index" t-value="0"/>
                                            <t t-set="processed_bobot_totals" t-value="{}"/>
                                            <t t-set="processed_bobot_totals2" t-value="{}"/>
                                            <t t-set="total3_sum" t-value="0"/>
                                            <t t-set="total_rows" t-value="0"/>
                                            
                                            <!-- Calculate total rows and TOTAL 3 sum -->
                                            <t t-foreach="grouped_skills.items()" t-as="group">
                                                <t t-set="total_rows" t-value="total_rows + len(group[1])"/>
                                            </t>
                                            
                                            <!-- Calculate TOTAL 3 sum -->
                                            <t t-foreach="bobot_totals.items()" t-as="bobot_total">
                                                <t t-set="bobot_key" t-value="bobot_total[0]"/>
                                                <t t-set="total_value" t-value="bobot_total[1]"/>
                                                <t t-set="bobot_clean" t-value="bobot_key.replace('%', '')"/>
                                                <t t-set="bobot_decimal" t-value="int(bobot_clean) / 100.0"/>
                                                <t t-set="total3_sum" t-value="total3_sum + (total_value * bobot_decimal)"/>
                                            </t>
                                            
                                            <t t-foreach="grouped_skills.items()" t-as="group">
                                                <t t-set="skill_type_name" t-value="group[0]"/>
                                                <t t-set="skills_list" t-value="group[1]"/>
                                                <t t-set="skill_count" t-value="len(skills_list)"/>
                                                <t t-set="total_value" t-value="skill_totals[skill_type_name]"/>
                                                <t t-set="average_value" t-value="round(total_value / skill_count, 2)"/>
                                                <t t-set="bobot_key" t-value="skills_list[0].bobot_penilaian_percentage"/>
                                                <t t-set="total_value" t-value="bobot_totals[bobot_key]"/>
                                                
                                                <t t-foreach="skills_list" t-as="skill">
                                                    <tr>
                                                        <t t-if="skill_index == 0">
                                                            <td class="text-center" t-att-rowspan="skill_count" style="font-size: 9px;"><t t-esc="global_row_index + 1"/></td>
                                                            <td class="text-center" t-att-rowspan="skill_count" style="font-size: 9px;"><t t-esc="skill.bobot_penilaian_percentage"/></td>
                                                            <td t-att-rowspan="skill_count" style="font-size: 9px;"><span t-esc="skill_type_name"/></td>
                                                        </t>
                                                        <td style="font-size: 9px;"><span t-field="skill.skill_id.name"/></td>
                                                        <td class="text-center" style="font-size: 9px;">
                                                            <t t-esc="int(skill.skill_level_id.level_progress / 20) if skill.skill_level_id.level_progress else 0"/>
                                                        </td>
                                                        <t t-if="skill_index == 0">
                                                            <td class="text-center" t-att-rowspan="skill_count" style="font-size: 9px;"><t t-esc="average_value"/></td>
                                                        </t>
                                                        
                                                        <!-- TOTAL column - merged by bobot percentage -->
                                                        <t t-if="bobot_key not in processed_bobot_totals">
                                                            <td class="text-center" t-att-rowspan="bobot_row_counts[bobot_key]" style="font-size: 9px;"><t t-esc="total_value"/></td>
                                                            <t t-set="processed_bobot_totals" t-value="dict(processed_bobot_totals, **{bobot_key: True})"/>
                                                        </t>
                                                        
                                                        <!-- TOTAL 2 column - TOTAL * bobot -->
                                                        <t t-if="bobot_key not in processed_bobot_totals2">
                                                            <t t-set="bobot_clean" t-value="bobot_key.replace('%', '')"/>
                                                            <t t-set="bobot_decimal" t-value="int(bobot_clean) / 100.0"/>
                                                            <t t-set="total2_value" t-value="round(total_value * bobot_decimal, 2)"/>
                                                            <td class="text-center" t-att-rowspan="bobot_row_counts[bobot_key]" style="font-size: 9px;"><t t-esc="total2_value"/></td>
                                                            <t t-set="processed_bobot_totals2" t-value="dict(processed_bobot_totals2, **{bobot_key: True})"/>
                                                        </t>

                                                        <!-- TOTAL 3 column - only show once -->
                                                        <t t-if="skill_index == 0 and skill_type_name == list(grouped_skills.keys())[0]">
                                                            <td class="text-center" t-att-rowspan="total_rows" style="font-size: 9px;"><strong><t t-esc="round(total3_sum, 2)"/></strong></td>
                                                        </t>
                                                    </tr>
                                                    <t t-set="global_row_index" t-value="global_row_index + 1"/>
                                                </t>
                                            </t>
                                        </t>
                                        <t t-else="">
                                            <tr>
                                                <td colspan="8" class="text-center" style="font-size: 9px;">No skills data available</td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>

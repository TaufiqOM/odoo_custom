<odoo>
    <record id="view_appraisal_skill_group_tree" model="ir.ui.view">
        <field name="name">appraisal.skill.group.tree</field>
        <field name="model">appraisal.skill.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    
    <record id="view_appraisal_skill_group_form" model="ir.ui.view">
        <field name="name">appraisal.skill.group.form</field>
        <field name="model">appraisal.skill.group</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="active"/>
                        <field name="company_id" options="{'no_open': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Modify existing appraisal skill view -->
    <record id="view_hr_appraisal_skill_form" model="ir.ui.view">
        <field name="name">hr.appraisal.skill.form.modified</field>
        <field name="model">hr.appraisal.skill</field>
        <field name="inherit_id" ref="hr_appraisal_skills.hr_appraisal_skills_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='skill_id']" position="before">
                <field name="group_id" widget="many2one_tags" options="{'no_create_edit': True}"/>
                <field name="custom_group" invisible="group_id != False"/>
            </xpath>
        </field>
    </record>
    
    <!-- Action and menu items -->
    <record id="action_appraisal_skill_group" model="ir.actions.act_window">
        <field name="name">Skill Groups</field>
        <field name="res_model">appraisal.skill.group</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a new skill group
            </p>
        </field>
    </record>
    
    <menuitem id="menu_appraisal_skill_group" name="Skill Groups" 
              parent="hr_appraisal.menu_hr_appraisal_root" 
              action="action_appraisal_skill_group" sequence="30"/>
</odoo>
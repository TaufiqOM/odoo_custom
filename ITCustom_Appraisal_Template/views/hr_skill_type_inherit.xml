<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit the hr.skill.type form to add kepemimpinan field -->
    <record id="hr_skill_type_view_form_inherit" model="ir.ui.view">
        <field name="name">hr.skill.type.form.inherit</field>
        <field name="model">hr.skill.type</field>
        <field name="inherit_id" ref="hr_skills.hr_employee_skill_type_view_form"/>
        <field name="arch" type="xml">
            <!-- Add kepemimpinan field with label after the name field -->
            <xpath expr="//field[@name='name']" position="after">
                <label for="kepemimpinan" string="Kepemimpinan"/>
                <field name="kepemimpinan"/>
            </xpath>
        </field>
    </record>
</odoo>

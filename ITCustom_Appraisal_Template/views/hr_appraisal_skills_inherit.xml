<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit the hr.appraisal form to add Get Data button in Skills tab -->
    <record id="view_hr_appraisal_form_skills_inherit" model="ir.ui.view">
        <field name="name">hr.appraisal.form.skills.inherit</field>
        <field name="model">hr.appraisal</field>
        <field name="inherit_id" ref="hr_appraisal_skills.view_hr_appraisal_form"/>
        <field name="arch" type="xml">
            <!-- Add Get Data button to the Skills tab -->
            <xpath expr="//page[@name='page_skills']//field[@name='skill_ids']" position="before">
                <div class="oe_button_box mb-2">
                    <button name="action_get_skills_data" 
                            string="Get Data" 
                            type="object" 
                            class="btn btn-primary"
                            icon="fa-download"
                            help="Get skills data for this appraisal"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>

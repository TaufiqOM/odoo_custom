<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit the project form view to update the Share Project button visibility -->
    <record id="edit_project_inherit" model="ir.ui.view">
        <field name="name">project.project.form.inherit</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_open_share_project_wizard']" position="attributes">
                <attribute name="invisible">privacy_visibility not in ['portal', 'invited_only']</attribute>
            </xpath>
        </field>
    </record>

    <!-- Inherit the project kanban view to update the Share Project menu item visibility -->
    <record id="view_project_kanban_inherit" model="ir.ui.view">
        <field name="name">project.project.kanban.inherit</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//a[@name='action_open_share_project_wizard']" position="attributes">
                <attribute name="t-if">record.privacy_visibility.raw_value in ['portal', 'invited_only']</attribute>
            </xpath>
        </field>
    </record>
</odoo>

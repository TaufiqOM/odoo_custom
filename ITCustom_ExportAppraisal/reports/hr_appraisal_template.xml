<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report template for PDF generation -->
    <template id="report_hr_appraisal_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="row">
                            <div class="col-12 text-center">
                                <h5>PENILAIAN KINERJA PT. OMEGA MAS</h5>
                            </div>
                        </div>
                        
                        <div class="row mt-4">
                            <div class="col-6">
                                <p><strong>Nama:</strong> <span t-field="o.employee_id.name"/></p>
                            </div>
                            <div class="col-6">
                                <p><strong>Departemen:</strong> <span t-field="o.employee_id.department_id.name"/></p>
                            </div>
                        </div>
                        
                        <div class="row mt-3">
                            <div class="col-6">
                                <p><strong>Tanggal Appraisal:</strong> <span t-field="o.date_close"/></p>
                            </div>
                            <div class="col-6">
                                <p><strong>Tanggal Appraisal Selanjutnya:</strong> <span t-field="o.next_appraisal_date"/></p>
                            </div>
                        </div>
                        
                        <div class="row mt-3">
                            <div class="col-12">
                                <p><strong>Nilai:</strong> <span t-field="o.assessment_note"/></p>
                            </div>
                        </div>
                        
                        <!-- New Skills Table -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <h5 class="mb-3">DATA KEAHLIAN (SKILLS)</h5>
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th class="text-center" style="width: 5%">No</th>
                                            <th class="text-center" style="width: 20%">Tipe Keahlian</th>
                                            <th class="text-center" style="width: 25%">Keahlian</th>
                                            <th class="text-center" style="width: 15%">Level</th>
                                            <th class="text-center" style="width: 15%">Dummy 1</th>
                                            <th class="text-center" style="width: 10%">Dummy 2</th>
                                            <th class="text-center" style="width: 10%">Dummy 3</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-if="o.skill_ids">
                                            <t t-set="grouped_skills" t-value="{}"/>
                                            
                                            <!-- Group skills by skill type -->
                                            <t t-foreach="o.skill_ids" t-as="skill">
                                                <t t-set="skill_type" t-value="skill.skill_type_id.name"/>
                                                <t t-if="skill_type in grouped_skills">
                                                    <t t-set="grouped_skills" t-value="dict(grouped_skills, **{skill_type: grouped_skills[skill_type] + [skill]})"/>
                                                </t>
                                                <t t-else="">
                                                    <t t-set="grouped_skills" t-value="dict(grouped_skills, **{skill_type: [skill]})"/>
                                                </t>
                                            </t>
                                            
                                            <!-- Render grouped skills -->
                                            <t t-set="global_row_index" t-value="0"/>
                                            <t t-foreach="grouped_skills.items()" t-as="group">
                                                <t t-set="skill_type_name" t-value="group[0]"/>
                                                <t t-set="skills_list" t-value="group[1]"/>
                                                <t t-set="skill_count" t-value="len(skills_list)"/>
                                                
                                                <t t-foreach="skills_list" t-as="skill">
                                                    <tr>
                                                        <t t-if="skill_index == 0">
                                                            <td class="text-center" t-att-rowspan="skill_count"><t t-esc="global_row_index + 1"/></td>
                                                            <td t-att-rowspan="skill_count"><span t-esc="skill_type_name"/></td>
                                                        </t>
                                                        <td><span t-field="skill.skill_id.name"/></td>
                                                        <td><span t-field="skill.skill_level_id.name"/></td>
                                                        <td class="text-center">-</td>
                                                        <td class="text-center">-</td>
                                                        <td class="text-center">-</td>
                                                    </tr>
                                                    <t t-if="skill_index == 0">
                                                        <t t-set="global_row_index" t-value="global_row_index + skill_count"/>
                                                    </t>
                                                </t>
                                            </t>
                                        </t>
                                        <t t-else="">
                                            <tr>
                                                <td colspan="7" class="text-center">Tidak ada data keahlian</td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        
                        <div class="row mt-3">
                            <div class="col-12">
                                <hr/>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
